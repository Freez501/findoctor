# ============================================================================
# Truespace — Переменные окружения (.env.example)
# ============================================================================

# Режим хранилища данных: 'json' (локальный файл) или 'supabase' (облачная база)
STORAGE_MODE=json

# Настройки сервера
PORT=3001
HOST=0.0.0.0

# Разрешённые CORS-источники (через запятую)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Секрет для генерации сессионных JWT токенов
JWT_SECRET=change-this-to-a-secure-random-secret-in-production-at-least-32-chars

# Supabase — Backend ключи (Service Role Key для полного серверного доступа)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Supabase — Frontend ключи (доступны клиенту Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Telegram Бот (опционально, для интеграции с реальным чатом)
# BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Отправка писем — через локальный sendmail (Exim4 на сервере, работает автоматически)
# Адрес отправителя (from):
MAIL_FROM=noreply@shved4656.fvds.ru

# Опционально — если нужен внешний SMTP (Яндекс, Gmail и т.д.):
# MAIL_SMTP_HOST=smtp.yandex.ru
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=your@yandex.ru
# MAIL_SMTP_PASS=your-smtp-password

